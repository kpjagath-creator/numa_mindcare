DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3001

# Auth
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173

# ââ Clinic timezone (TZ-01) âââââââââââââââââââââââââââââââââââââââââââââââââââ
# The IANA zone every scheduling input is interpreted in. Sessions are entered as clinic
# wall-clock times and stored as absolute instants; this is what converts between the two, so it
# must NOT depend on the server timezone. Defaults to Asia/Kolkata; override only if the clinic
# physically relocates. Setting TZ on the host is fine operationally but is never the correctness
# mechanism - the application converts explicitly.
CLINIC_TIME_ZONE=Asia/Kolkata

# Set by Render in production; leave unset for local dev.
# NODE_ENV=production

# ── Google Calendar / Meet integration (MEET-01) ──────────────────────────────
# OAuth 2.0 credentials for the dedicated Numa Google account. A service account is NOT usable:
# creating a Meet conference and delivering attendee invitations requires acting as a user, which
# needs domain-wide delegation, which requires Google Workspace.
#
# !! DEPLOYMENT PREREQUISITE !! While the Cloud Console OAuth app is in "Testing" publishing
# status, Google expires refresh tokens after 7 DAYS and the integration silently stops working.
# The OAuth app MUST be published to "In production". Full Google verification is not required
# for this single-account use case — an unverified production app shows a one-time consent
# interstitial and issues non-expiring refresh tokens.
#
# Scope needed: https://www.googleapis.com/auth/calendar.events
# Leave these unset to disable the integration: sessions still schedule normally and their
# meeting status is recorded as FAILED, retryable from the session UI once configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to write events to. "primary" = the dedicated account's own calendar.
GOOGLE_CALENDAR_ID=primary
# IANA zone the clinic books in; Calendar must be told explicitly rather than guessing.
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
