{
  "name": "numa-mindcare-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/app.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/app.ts",
    "build": "tsc --build",
    "start": "node build/app.js",
    "prisma:generate": "prisma generate",
    "reset-admin-password": "ts-node src/scripts/resetAdminPassword.ts",
    "cleanup-dummy-data": "ts-node src/scripts/cleanupDummyData.ts",
    "seed-test-dataset": "ts-node src/scripts/seedTestDataset.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
